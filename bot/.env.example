# Get this from @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Optional: a chat/group/channel id where new bookings & orders get posted.
# Leave empty to disable admin notifications.
TELEGRAM_ADMIN_CHAT_ID=

# Optional: once the website is deployed with HTTPS, set this to open the real
# booking/order pages as Telegram Mini Apps instead of the text-based flows.
# Example: https://tyaga-pyriatyn.example.com
WEBAPP_URL=

# Must point to the SAME database file the website uses.
DATABASE_FILE=/home/claude/tyaga-project/data/tyaga.db
